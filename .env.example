# Example environment variables for lf-automation-tests
# Copy this file to .env and edit values as needed. Do not commit secrets.

# Base client-facing site URL
BASE_CLIENT_URL=https://example.com

# Base admin site URL (optional; derived from BASE_CLIENT_URL + /admin when not set)
BASE_ADMIN_URL=https://example.com/admin

# Base API URL for API tests
BASE_API_URL=https://jsonplaceholder.typicode.com

# ADMIN credentials
ADMIN_EMAIL=admin
ADMIN_PASSWORD=adminpassword

# HEADLESS mode for browser tests, if the variable does not exist then defaults to true
HEADLESS=false
